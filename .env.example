# Public URL of the site (canonical links, Open Graph, sitemap)
NEXT_PUBLIC_SITE_URL=https://example.com

# Contact form delivery via Resend (https://resend.com)
# Without these, the form shows an honest "not connected yet" message.
RESEND_API_KEY=
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL="Blerta website <hello@your-verified-domain.com>"
